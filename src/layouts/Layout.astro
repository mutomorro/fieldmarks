---
interface Breadcrumb {
  name: string;
  url: string;
}

interface ArticleSchema {
  headline: string;
  description: string;
  author?: string;
}

interface Props {
  title: string;
  description?: string;
  transparentNav?: boolean;
  pageType?: 'website' | 'article';
  ogImage?: string;
  breadcrumbs?: Breadcrumb[];
  articleSchema?: ArticleSchema;
}

const {
  title,
  description = 'A practical guide to systems thinking for people who work in organisations.',
  transparentNav = false,
  pageType = 'website',
  ogImage = '/icon-192.png',
  breadcrumbs,
  articleSchema,
} = Astro.props;

const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/themes/', label: 'Themes' },
  { href: '/concepts/', label: 'Concepts' },
  { href: '/collections/', label: 'Collections' },
  { href: '/connections/', label: 'Connections' },
  { href: '/about/', label: 'About' },
];

// Build canonical URL with trailing slash
const siteOrigin = Astro.site ? Astro.site.origin : 'https://fieldmarks.org';
const pathWithSlash = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const canonicalUrl = `${siteOrigin}${pathWithSlash}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteOrigin}${ogImage}`;

const fullTitle = `${title} - Fieldmarks`;
const isHome = currentPath === '/' || currentPath === '';

// JSON-LD blocks
const jsonLdBlocks: object[] = [];

if (isHome) {
  jsonLdBlocks.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Fieldmarks',
    url: `${siteOrigin}/`,
    description: 'A field guide to systems thinking.',
    publisher: {
      '@type': 'Organization',
      name: 'Mutomorro',
      url: 'https://mutomorro.com',
    },
  });
}

if (breadcrumbs && breadcrumbs.length > 0) {
  jsonLdBlocks.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: b.url.startsWith('http') ? b.url : `${siteOrigin}${b.url.endsWith('/') || b.url === '/' ? b.url : b.url + '/'}`,
    })),
  });
}

if (articleSchema) {
  jsonLdBlocks.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articleSchema.headline,
    description: articleSchema.description,
    url: canonicalUrl,
    image: ogImageUrl,
    ...(articleSchema.author && {
      author: { '@type': 'Person', name: articleSchema.author },
    }),
    publisher: {
      '@type': 'Organization',
      name: 'Mutomorro',
      url: 'https://mutomorro.com',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Fieldmarks" />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;500&display=swap" rel="stylesheet" />

    <!-- PostHog Analytics -->
    <script is:inline>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('phc_AFHLnKyHjXTCAUqffnk4X8ythioJPwcTDi4JajAjFgcQ', {
        api_host: '/ingest',
        ui_host: 'https://eu.posthog.com',
      });
    </script>

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class:list={["min-h-screen flex flex-col", { "transparent-nav-page": transparentNav }]}>

    <!-- Navigation -->
    <nav id="main-nav" class:list={["fixed top-0 left-0 right-0 z-[100] flex items-center justify-between px-12 py-5 transition-all duration-300", { "nav-transparent": transparentNav }]} style="background: rgba(255,255,255,0);">
      <div class="flex items-center gap-2.5">
        <a href="/" class="flex items-center gap-2.5 no-underline">
          <svg viewBox="0 0 26 26" fill="none" class="w-[26px] h-[26px] nav-logo">
            <rect x="1" y="1" width="5" height="5" fill="currentColor" opacity="0.5"/>
            <rect x="10" y="1" width="5" height="5" fill="currentColor" opacity="0.5"/>
            <rect x="19" y="1" width="5" height="5" fill="currentColor" opacity="0.5"/>
            <rect x="1" y="10" width="5" height="5" fill="currentColor" opacity="0.5"/>
            <rect x="10" y="10" width="5" height="5" fill="#9B51E0"/>
            <rect x="19" y="10" width="5" height="5" fill="currentColor" opacity="0.5"/>
            <rect x="1" y="19" width="5" height="5" fill="currentColor" opacity="0.5"/>
            <rect x="10" y="19" width="5" height="5" fill="currentColor" opacity="0.5"/>
            <rect x="19" y="19" width="5" height="5" fill="currentColor" opacity="0.5"/>
          </svg>
          <span class="nav-title text-[17px] font-normal tracking-[0.02em]" style="color: var(--deep);">Fieldmarks</span>
        </a>
        <span class="nav-byline text-[14px] font-light hidden sm:inline" style="color: var(--soft);">by <a href="https://mutomorro.com" target="_blank" rel="noopener" class="no-underline transition-colors duration-200" style="color: var(--soft);">Mutomorro</a></span>
      </div>
      <ul class="flex gap-8 list-none m-0 p-0">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath === href || currentPath === href + '/';
          return (
            <li>
              <a
                href={href}
                class:list={["nav-link text-[14px] font-normal no-underline transition-colors duration-200 hover:!text-[var(--deep)]", { "nav-active": isActive }]}
                style="color: var(--soft);"
              >{label}</a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Main content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-columns">
        <div class="footer-col">
          <div class="footer-col-heading">Fieldmarks</div>
          <a href="/concepts/">Concepts</a>
          <a href="/about/">About</a>
          <a href="/collections/">Collections</a>
          <a href="/connections/">Connections</a>
        </div>
        <div class="footer-col">
          <div class="footer-col-heading">Themes</div>
          <a href="/theme/core-building-blocks/">Core building blocks</a>
          <a href="/theme/systems-archetypes/">Systems archetypes</a>
          <a href="/theme/complexity-and-uncertainty/">Complexity and uncertainty</a>
          <a href="/theme/resilience-and-change/">Resilience and change</a>
        </div>
        <div class="footer-col">
          <div class="footer-col-heading">Mutomorro</div>
          <p class="footer-mutomorro-desc">A <a href="https://mutomorro.com" target="_blank" rel="noopener">Mutomorro</a> project</p>
          <p class="footer-mutomorro-tagline">Organisational consulting and thought leadership</p>
        </div>
      </div>
      <div class="footer-bottom">
        <span>Fieldmarks. Free and open.</span>
      </div>
    </footer>

  </body>
</html>

<style is:global>
  :root {
    --deep: #221C2B;
    --mid: #423B49;
    --soft: #6B6577;
    --accent: #9B51E0;
    --warm-bg: #FAF9F7;
    --white: #FFFFFF;
    --border: rgba(34,28,43,0.08);
    --border-hover: rgba(34,28,43,0.18);
  }
  html {
    font-family: 'Source Sans 3', system-ui, sans-serif;
    font-weight: 400;
    color: var(--deep);
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, h4, h5, h6 { font-weight: 400; }
  *, *::before, *::after { border-radius: 0 !important; }
</style>

<style>
  @media (max-width: 768px) {
    nav { padding: 16px 24px !important; }
  }
  .nav-active {
    color: var(--deep) !important;
    border-bottom: 1.5px solid var(--accent);
    padding-bottom: 2px;
  }

  nav.scrolled {
    background: rgba(255,255,255,0.92) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  /* Transparent nav for immersive pages (connections) */
  nav.nav-transparent {
    background: transparent !important;
  }
  nav.nav-transparent .nav-logo { color: rgba(255,255,255,0.5); }
  nav.nav-transparent .nav-title { color: rgba(255,255,255,0.9) !important; }
  nav.nav-transparent .nav-byline,
  nav.nav-transparent .nav-byline a { color: rgba(255,255,255,0.4) !important; }
  nav.nav-transparent .nav-link { color: rgba(255,255,255,0.5) !important; }
  nav.nav-transparent .nav-link:hover { color: rgba(255,255,255,0.9) !important; }
  nav.nav-transparent .nav-active { color: rgba(255,255,255,0.9) !important; border-bottom-color: rgba(255,255,255,0.5); }
  nav.nav-transparent.scrolled {
    background: rgba(17, 15, 24, 0.85) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  /* Hide footer on transparent-nav (immersive) pages */
  .transparent-nav-page .footer { display: none; }

  /* ====== FOOTER ====== */
  .footer {
    background: #F3F3F3;
    padding: 64px 48px 40px;
  }
  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    margin-bottom: 48px;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-col-heading {
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(34, 28, 43, 0.35);
    margin-bottom: 8px;
  }
  .footer-col a {
    font-size: 14px;
    font-weight: 300;
    color: var(--mid);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-col a:hover {
    color: var(--accent);
  }
  .footer-mutomorro-desc {
    font-size: 14px;
    font-weight: 300;
    color: var(--mid);
    margin: 0;
  }
  .footer-mutomorro-desc a {
    font-weight: 400;
  }
  .footer-mutomorro-tagline {
    font-size: 14px;
    font-weight: 300;
    color: rgba(34, 28, 43, 0.4);
    margin: 0;
  }
  .footer-bottom {
    border-top: 1px solid rgba(34, 28, 43, 0.1);
    padding-top: 24px;
  }
  .footer-bottom span {
    font-size: 13px;
    font-weight: 300;
    color: rgba(34, 28, 43, 0.4);
  }

  @media (max-width: 768px) {
    .footer { padding: 40px 24px 32px; }
    .footer-columns {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

<script is:inline>
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 80);
  });
</script>
